    {
      "id": "b1-15",
      "name": "Check Request",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        660,
        40
      ],
      "parameters": {
        "jsCode": "// Normalises the settings and, for webhook calls, checks the message server-side.\nconst s = $('Buffer Settings').first().json;\nconst num = (v, def, min) => (Number.isFinite(Number(v)) && Number(v) >= min ? Math.floor(Number(v)) : def);\nconst cfg = {\n  table: String(s.buffer_table_name ?? '').trim(),\n  debounce: num(s.debounce_seconds, 5, 1),\n  max_wait: num(s.max_wait_seconds, 30, 1),\n  max_messages: num(s.max_messages, 10, 1),\n  max_text_length: num(s.max_text_length, 4000, 1),\n  max_attempts: num(s.max_attempts, 3, 1),\n  bot_workflow_id: String(s.bot_workflow_id ?? '').trim(),\n  retry_after: num(s.retry_after_seconds, 120, 1),\n};\nif (!$('Receive Chat Message').isExecuted) return [{ json: { ok: true, source: 'schedule', cfg } }];\nconst b = $('Receive Chat Message').first().json.body;\nconst fail = (error) => [{ json: { ok: false, source: 'webhook', error, cfg } }];\nif (!b || typeof b !== 'object' || Array.isArray(b)) return fail('Send a JSON object with sender_id and text.');\nconst sender = typeof b.sender_id === 'string' || typeof b.sender_id === 'number' ? String(b.sender_id).trim() : '';\nif (!sender) return fail('sender_id is required.');\nif (sender.length > 200) return fail('sender_id is longer than 200 characters.');\nconst text = typeof b.text === 'string' ? b.text.trim() : typeof b.text === 'number' ? String(b.text) : '';\nif (!text) return fail('text is required and cannot be empty.');\nif (text.length > cfg.max_text_length) return fail('text is longer than ' + cfg.max_text_length + ' characters.');\nreturn [{ json: { ok: true, source: 'webhook', sender_id: sender, text, received_ms: Date.now(), cfg } }];"
      }
    },
