    {
      "id": "b1-48",
      "name": "Count Failed Attempt",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "executeOnce": true,
      "position": [
        5400,
        360
      ],
      "parameters": {
        "jsCode": "// The bot workflow failed: release the batch for a retry, or park it after max_attempts.\nconst b = $('Build Combined Message').first().json;\nconst max = $('Check Request').first().json.cfg.max_attempts;\nconst e = $input.first().json.bot_error;\nconst error = String((e && typeof e === 'object' ? e.message || JSON.stringify(e) : e) || 'unknown error').slice(0, 500);\nconst attempts = b.attempts + 1;\nconst park = attempts >= max;\nreturn [{ json: { batch_id: b.batch_id, new_batch_id: park ? 'parked-' + b.batch_id : '', attempts, park, last_error: error } }];"
      }
    },
