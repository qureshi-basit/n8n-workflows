      "parameters": {
        "resource": "row",
        "operation": "get",
        "dataTableId": {
          "__rl": true,
          "mode": "id",
          "value": "={{ $('Find Data Tables').all().find((t) => t.json.name === $('Stock Request Settings').first().json.stock_table_name.trim()).json.id }}"
        },
        "matchType": "allConditions",
        "filters": {
          "conditions": [
            {
              "keyName": "id",
              "condition": "eq",
              "keyValue": "={{ Number((String($json['Item'] ?? '').match(/^#(\\d+) /) || [])[1] || 0) }}"
            }
          ]
        },
        "returnAll": false,
        "limit": 1
      }
    },
    {
      "id": "s2-29",
      "name": "Check Request",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "executeOnce": true,
      "position": [
        2380,
        140
      ],
      "parameters": {
        "jsCode": "// Server-side re-check of page 2 against the stock row read a moment ago.\n// Never trusts the dropdown text: only the leading #id is used, and stock comes from the table.\nconst page = $('Choose Item and Quantity').last().json;\nconst row = $input.first().json;\nconst settings = $('Stock Request Settings').first().json;\nconst maxQty = Number(settings.max_quantity_per_request) || 0;\nconst fail = (error) => [{ json: { ok: false, error } }];\nconst match = String(page['Item'] ?? '').match(/^#(\\d+) /);\nif (!match) return fail('That choice is not one of the listed items.');\nconst itemId = Number(match[1]);\nif (row.id !== itemId) return fail('That item is not in the stock list.');\nconst name = String(row.name ?? '').trim() || 'Item ' + row.id;\nif (row.active !== true) return fail(name + ' is no longer available.');\nconst stock = row.stock === null || row.stock === '' ? NaN : Number(row.stock);\nif (!Number.isFinite(stock) || stock <= 0) return fail(name + ' is out of stock now.');\nconst raw = page['Quantity'];\nconst qty = typeof raw === 'number' ? raw : (String(raw ?? '').trim() === '' ? NaN : Number(raw));\nif (!Number.isInteger(qty) || qty < 1) return fail('Please enter a whole number of at least 1.');\nif (maxQty > 0 && qty > maxQty) return fail('You can ask for at most ' + maxQty + ' per request.');\nif (qty > stock) return fail('Only ' + stock + ' of ' + name + ' left, so ' + qty + ' cannot be taken.');\nconst newStock = stock - qty;\nconst thresholdRaw = row.low_stock_threshold;\nconst threshold = thresholdRaw === null || thresholdRaw === undefined || thresholdRaw === '' ? NaN : Number(thresholdRaw);\nlet newFlag = row.low_alert_sent === true;\nlet sendAlert = false;\nif (Number.isFinite(threshold)) {\n  if (newStock > threshold) newFlag = false;\n  else { sendAlert = !newFlag || stock > threshold; newFlag = true; }\n}\nconst requester = $('Check Requester').first().json;\nreturn [{ json: {\n  ok: true, item_id: itemId, item_name: name, unit: String(row.unit ?? '').trim(), quantity: qty,\n  stock_seen: stock, new_stock: newStock, threshold: Number.isFinite(threshold) ? threshold : null,\n  new_flag: newFlag, send_alert: sendAlert,\n  token: $execution.id + '-' + $runIndex,\n  note: String(page['What is it for?'] ?? '').trim().slice(0, 500),\n  requester_name: requester.name, requester_email: requester.email,\n} }];"
      }
    },
