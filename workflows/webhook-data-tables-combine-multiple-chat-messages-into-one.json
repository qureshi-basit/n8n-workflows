    {
      "id": "b1-40",
      "name": "Build Combined Message",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        4300,
        200
      ],
      "parameters": {
        "jsCode": "// Joins the claimed messages in arrival order (row id) into the bot's input.\nconst batch = $('Loop Over Batches').first().json;\nconst rows = $input.all().map((i) => i.json).filter((r) => r.id !== undefined && r.batch_id === batch.token).sort((a, b) => a.id - b.id);\nif (!rows.length) return [{ json: { claimed: false, sender_id: batch.sender_id } }];\nconst iso = (ms) => new Date(Number(ms)).toISOString();\nreturn [{ json: {\n  claimed: true,\n  sender_id: rows[0].sender_id,\n  combined_text: rows.map((r) => r.text).join('\\n'),\n  message_count: rows.length,\n  messages: rows.map((r) => ({ id: r.id, text: r.text, received_at: iso(r.received_ms) })),\n  first_received_at: iso(rows[0].received_ms),\n  last_received_at: iso(rows[rows.length - 1].received_ms),\n  batch_id: batch.token,\n  reason: batch.reason,\n  attempts: Math.max(0, ...rows.map((r) => Number(r.attempts) || 0)),\n} }];"
      }
