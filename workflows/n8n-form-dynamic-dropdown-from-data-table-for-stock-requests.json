    {
      "id": "s2-28",
      "name": "Load Chosen Item",
      "type": "n8n-nodes-base.dataTable",
      "typeVersion": 1.1,
      "executeOnce": true,
      "alwaysOutputData": true,
      "position": [
        2160,
        140
