    {
      "id": "s2-23",
      "name": "Build Item Page",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1440,
        140
      ],
      "parameters": {
        "jsCode": "// Turn the in-stock rows into the JSON field list of the item page.\n// n8n dropdown options have no separate value, so each option starts with the stable row id (#12);\n// Check Request reads only that id and ignores the stock number shown in the label.\nconst asNumber = (v) => (v === null || v === undefined || v === '' ? NaN : Number(v));\nconst items = $input.all().map((i) => i.json)\n  .filter((r) => r.id !== undefined && r.active === true && Number.isFinite(asNumber(r.stock)) && asNumber(r.stock) > 0)\n  .sort((a, b) => String(a.name).localeCompare(String(b.name)));\nconst clean = (v) => String(v ?? '').replace(/[<>]/g, '').replace(/\\s+/g, ' ').trim();\nconst options = items.map((r) => ({ option: '#' + r.id + ' · ' + (clean(r.name) || 'Item ' + r.id) + ' · in stock: ' + asNumber(r.stock) + (clean(r.unit) ? ' ' + clean(r.unit) : '') }));\nconst retry = $('Ask Again').isExecuted ? $('Ask Again').last().json : null;\nconst fields = [\n  { fieldLabel: 'Item', fieldType: 'dropdown', requiredField: true, fieldOptions: { values: options } },\n  { fieldLabel: 'Quantity', fieldType: 'number', requiredField: true, placeholder: 'e.g. 2' },\n  { fieldLabel: 'What is it for?', fieldType: 'textarea', placeholder: 'Optional note for the stock keeper' },\n];\nreturn [{ json: {\n  item_count: items.length,\n  form_fields: JSON.stringify(fields),\n  page_description: retry ? retry.reason + ' Please choose again (try ' + (retry.attempt + 1) + ' of ' + retry.max_attempts + ').' : 'Only items in stock right now are listed.',\n} }];"
      }
    },
