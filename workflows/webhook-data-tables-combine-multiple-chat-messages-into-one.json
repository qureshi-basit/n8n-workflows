    {
      "id": "b1-33",
      "name": "Load Sender Waiting Messages",
      "type": "n8n-nodes-base.dataTable",
      "typeVersion": 1.1,
      "alwaysOutputData": true,
      "position": [
        2920,
        0
      ],
      "parameters": {
        "resource": "row",
        "operation": "get",
        "dataTableId": {
          "__rl": true,
          "mode": "id",
          "value": "={{ $('Find Buffer Table').all().find((t) => t.json.name === $('Check Request').first().json.cfg.table).json.id }}"
        },
        "matchType": "allConditions",
        "filters": {
          "conditions": [
            {
              "keyName": "sender_id",
              "condition": "eq",
              "keyValue": "={{ $('Check Request').first().json.sender_id }}"
            },
            {
