    {
      "id": "b1-36",
      "name": "Group Overdue by Sender",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1980,
        540
      ],
      "parameters": {
        "jsCode": "// Batches of at most max_messages per sender for messages left waiting too long\n// (released after a bot failure, or left by a run lost in a restart).\nconst max = $('Check Request').first().json.cfg.max_messages;\nconst rows = $input.all().map((i) => i.json).filter((r) => r.id !== undefined && r.sender_id !== undefined).sort((a, b) => a.id - b.id);\nconst bySender = new Map();\nfor (const r of rows) bySender.set(r.sender_id, [...(bySender.get(r.sender_id) || []), r]);\nconst out = [];\nfor (const [sender_id, list] of bySender) for (let i = 0; i < list.length; i += max) {\n  const chunk = list.slice(i, i + max);\n  out.push({ json: { sender_id, from_id: chunk[0].id, up_to_id: chunk[chunk.length - 1].id, token: $execution.id + '-' + (out.length + 1), reason: 'retry' } });\n}\nreturn out;"
      }
    },
