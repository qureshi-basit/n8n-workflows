        4960,
        200
      ],
      "parameters": {
        "jsCode": "// The bot's own output is not used, so a bot ending with no items still counts as delivered.\n// Send to Bot Workflow continues with one item holding only { error } when the bot workflow failed or could not start.\nconst items = $input.all().map((i) => i.json);\nconst failed = items.length === 1 && Object.keys(items[0]).length === 1 && items[0].error !== undefined;\nreturn [{ json: { batch_id: $('Build Combined Message').first().json.batch_id, bot_failed: failed, bot_error: failed ? items[0].error : null } }];"
      }
