    {
      "id": "b1-50",
      "name": "Find Parked or Stuck Batches",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        3860,
        560
      ],
      "parameters": {
        "jsCode": "// Runs once every batch is handled. A parked batch, or one that could not be released or\n// cleared (its rows keep their batch_id), makes the run fail so it reaches your error workflow.\n// A failed Data Table step continues with { error } or with its own input item (the fields of\n// Count Failed Attempt or Check Bot Result); both are recognised here.\nconst items = $input.all().map((i) => i.json);\nconst list = (a) => [...new Set(a)].join(', ');\nconst tokens = ($('Decide Who Sends').isExecuted ? $('Decide Who Sends') : $('Group Overdue by Sender')).all().map((i) => i.json.token);\nconst parked = items.filter((j) => j.id !== undefined && String(j.batch_id).startsWith('parked-')).map((j) => j.batch_id);\nconst notReleased = items.filter((j) => j.park !== undefined).map((j) => j.batch_id);\nconst notCleared = items.filter((j) => j.bot_failed !== undefined).map((j) => j.batch_id);\nconst errors = items.filter((j) => j.id === undefined && j.error !== undefined).map((j) => String(j.error.message || j.error));\nconst parts = [];\nif (parked.length) parts.push('Parked after max_attempts: batch_id ' + list(parked) + '. Fix the cause, then clear batch_id to resend.');\nif (notReleased.length) parts.push('Could not release failed batch ' + list(notReleased) + '; its rows keep their batch_id and are not resent.');\nif (notCleared.length) parts.push('Could not delete delivered batch ' + list(notCleared) + '; its rows stay with their batch_id.');\nif (errors.length) parts.push('A batch of this run (batch_id ' + list(tokens) + ') could not be released or cleared; its rows keep their batch_id: ' + list(errors).slice(0, 400));\nreturn parts.length ? [{ json: { message: parts.join(' ') } }] : [];"
      }
    },
