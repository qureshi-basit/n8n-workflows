      "parameters": {
        "jsCode": "// Why the item page is shown again, and how many tries are left.\nconst c = $('Check Request').last().json;\nconst max = Number($('Stock Request Settings').first().json.max_attempts) || 3;\nconst attempt = $runIndex + 1;\n// A failed Take Stock passes its input item (the Check Request result) on, from either output.\nconst input = $input.first().json;\nconst writeFailed = c.ok && input.ok === true && input.token === c.token;\nconst reason = !c.ok ? c.error\n  : writeFailed ? 'The stock of ' + c.item_name + ' could not be updated, so nothing was taken.'\n  : 'Someone else changed the stock of ' + c.item_name + ' while you were sending this.';\nreturn [{ json: { reason, attempt, max_attempts: max, tries_left: attempt < max } }];"
      }
