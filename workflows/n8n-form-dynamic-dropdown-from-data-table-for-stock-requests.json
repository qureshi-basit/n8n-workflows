        "operation": "update",
        "dataTableId": {
          "__rl": true,
          "mode": "id",
          "value": "={{ $('Find Data Tables').all().find((t) => t.json.name === $('Stock Request Settings').first().json.stock_table_name.trim()).json.id }}"
        },
        "matchType": "allConditions",
        "filters": {
          "conditions": [
            {
              "keyName": "id",
              "condition": "eq",
              "keyValue": "={{ $json.item_id }}"
            },
            {
              "keyName": "stock",
              "condition": "eq",
              "keyValue": "={{ $json.stock_seen }}"
            }
          ]
        },
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "stock": "={{ $json.new_stock }}",
            "low_alert_sent": "={{ $json.new_flag }}",
            "change_token": "={{ $json.token }}"
          },
          "matchingColumns": [],
          "schema": [
            {
              "id": "stock",
              "displayName": "stock",
              "required": false,
              "defaultMatch": false,
              "display": true,
              "type": "number",
              "readOnly": false,
              "removed": false
            },
            {
              "id": "low_alert_sent",
              "displayName": "low_alert_sent",
              "required": false,
              "defaultMatch": false,
              "display": true,
              "type": "boolean",
              "readOnly": false,
              "removed": false
            },
            {
              "id": "change_token",
