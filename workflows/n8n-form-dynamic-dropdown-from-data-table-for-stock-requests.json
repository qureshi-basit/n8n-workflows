    {
      "id": "s2-14",
      "name": "Check Requester",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        280,
        160
      ],
      "parameters": {
        "jsCode": "// Page 1: name and email are required. Whitespace-only input counts as empty.\nconst s = $input.first().json;\nconst name = String(s['Your Name'] ?? '').trim();\nconst email = String(s['Your Email'] ?? '').trim().toLowerCase();\nif (!name) return [{ json: { ok: false, error: 'Please enter your name.' } }];\nif (!/^[^\\s@<>\"']+@[^\\s@<>\"']+\\.[^\\s@<>\"']+$/.test(email)) return [{ json: { ok: false, error: 'Please enter a valid email address.' } }];\nreturn [{ json: { ok: true, name: name.slice(0, 200), email } }];"
      }
    },
