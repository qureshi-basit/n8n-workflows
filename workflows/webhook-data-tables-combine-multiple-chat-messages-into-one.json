    {
      "id": "b1-34",
      "name": "Decide Who Sends",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        3140,
        0
      ],
      "parameters": {
        "jsCode": "// Latest message wins: after the quiet period only the run of the sender's newest waiting\n// message sends, unless the oldest has waited max_wait. A batch never holds more than\n// max_messages: full batches (oldest first) go at once, a smaller rest follows the rules above.\nconst c = $('Check Request').first().json;\nconst max = c.cfg.max_messages;\nconst me = $('Add to Buffer').first().json.id;\nconst rows = $input.all().map((i) => i.json).filter((r) => r.id !== undefined).sort((a, b) => a.id - b.id);\n// id plus arrival time: a deleted row's id can be given to a newer message\nif (!rows.some((r) => r.id === me && Number(r.received_ms) === c.received_ms)) return []; // already sent in an earlier batch\nconst out = [];\nfor (let i = 0; i < rows.length; i += max) {\n  const chunk = rows.slice(i, i + max);\n  const last = chunk[chunk.length - 1];\n  const reason = chunk.length === max ? 'max_messages'\n    : Date.now() - Number(chunk[0].received_ms) >= c.cfg.max_wait * 1000 ? 'max_wait'\n    : last.id === me ? 'quiet' : '';\n  if (!reason) break; // a newer message is waiting; its run decides\n  out.push({ json: { sender_id: c.sender_id, from_id: chunk[0].id, up_to_id: last.id, token: $execution.id + '-' + (out.length + 1), reason } });\n}\nreturn out;"
      }
    },
    {
      "id": "b1-35",
      "name": "Load Overdue Messages",
      "type": "n8n-nodes-base.dataTable",
      "typeVersion": 1.1,
      "alwaysOutputData": true,
      "position": [
        1760,
        540
      ],
      "parameters": {
        "resource": "row",
        "operation": "get",
        "dataTableId": {
          "__rl": true,
          "mode": "id",
          "value": "={{ $('Find Buffer Table').all().find((t) => t.json.name === $('Check Request').first().json.cfg.table).json.id }}"
        },
        "matchType": "allConditions",
        "filters": {
          "conditions": [
            {
              "keyName": "batch_id",
              "condition": "isEmpty"
            },
            {
